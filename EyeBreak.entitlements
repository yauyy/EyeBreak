<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- App 沙盒 -->
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<!-- 只允许主动联网，用于检查更新 -->
	<key>com.apple.security.network.client</key>
	<true/>
</dict>
</plist>
